# Postgres (Neon) — source of truth for money and workflow state.
# Use the pooled/HTTP-compatible connection string from the Neon dashboard.
DATABASE_URL=

# MongoDB (Atlas) — policy knowledge base + decision log.
# e.g. mongodb+srv://<user>:<password>@<cluster>.mongodb.net/refund_triage?retryWrites=true&w=majority
# If the +srv form fails locally with "querySrv ECONNREFUSED" (seen on
# Windows dev machines — Node's resolver can pick a broken DNS server that
# the OS itself knows to skip), use Atlas's non-SRV "standard connection
# string" instead (Atlas UI → Connect → Drivers → there's a toggle for it).
# Not an issue in production; Vercel's Linux runtime resolves SRV fine.
MONGODB_URI=

# Azure AI Foundry — used via the `openai` npm package's plain OpenAI
# client, pointed at {AZURE_OPENAI_ENDPOINT}/openai/v1 as baseURL (this
# resource is a Foundry project endpoint, not a classic per-resource Azure
# OpenAI endpoint, so no api-version param is needed). Calls are made by
# deployment name, not raw model ID, so the two deployment names below must
# match what you named them when deploying the models in Foundry.
# Base endpoint ONLY — e.g. https://<project>.services.ai.azure.com
# (Foundry's "Target URI" field gives the full request URL including a path
# suffix like /openai/v1/responses; strip that back to just the origin.)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
# Deployment name for the gpt-4o-mini-equivalent chat model (eligibility decisions)
AZURE_OPENAI_CHAT_DEPLOYMENT=
# Deployment name for the text-embedding-3-small-equivalent embedding model (retrieval)
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
