# Postgres (Neon) — source of truth for money and workflow state.
# Use the pooled/HTTP-compatible connection string from the Neon dashboard.
DATABASE_URL=

# MongoDB (Atlas) — policy knowledge base + decision log.
# e.g. mongodb+srv://<user>:<password>@<cluster>.mongodb.net/refund_triage?retryWrites=true&w=majority
MONGODB_URI=

# Azure AI Foundry (Azure OpenAI resource) — used via the `openai` npm
# package's AzureOpenAI client. Calls are made by deployment name, not raw
# model ID, so the two deployment names below must match what you named
# them when deploying the models in the Foundry/Azure OpenAI Studio portal.
# e.g. https://<resource-name>.openai.azure.com/
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
# e.g. 2024-10-21 — use the GA version shown in your deployment's "Target URI"
AZURE_OPENAI_API_VERSION=
# Deployment name for the gpt-4o-mini-equivalent chat model (eligibility decisions)
AZURE_OPENAI_CHAT_DEPLOYMENT=
# Deployment name for the text-embedding-3-small-equivalent embedding model (retrieval)
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
